# Copie para .env e preencha os valores. O arquivo .env NÃO deve ser versionado.

# --- Container PostgreSQL (docker-compose) ---
POSTGRES_DB=authdb
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=

# --- Backend ---
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USER=auth_user
DB_PASSWORD=

# String aleatória com no mínimo 32 bytes - Pode gerar com 'openssl rand -base64 48'
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost:3000
